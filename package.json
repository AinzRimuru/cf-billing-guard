  "description": "Per-request D1/KV call limiter for Cloudflare Workers — zero-intrusion Proxy wrapping that keeps runaway requests off your bill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AinzRimuru/cf-billing-guard.git"
  },
  "bugs": {
    "url": "https://github.com/AinzRimuru/cf-billing-guard/issues"
  },
  "homepage": "https://github.com/AinzRimuru/cf-billing-guard#readme",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "cf-billing-guard": "cli.js"
  },
  "files": [
    "index.js",
    "ledger.js",
    "d1.js",
    "kv.js",
    "adapter.js",
    "services.js",
